- name: rnd
  type: table
  desc: PCG Random Number Generator Native Extension for the Defold Game Engine
  members:
    - name: new
      type: function
      desc: Creates an isolated RNG context and returns its context id. Call without arguments to seed from entropy, with init_state to use init_seq = 1, or with init_state and init_seq for exact unsigned 32-bit deterministic seeding.
      parameters:
        - name: init_state
          type: number
          desc: Optional starting state for the RNG. Must be an unsigned 32-bit integer.
        - name: init_seq
          type: number
          desc: Optional output sequence for the RNG. Must be an unsigned 32-bit integer.
      returns:
        - name: Id
          type: number
          desc: RNG context id.

    - name: new64
      type: function
      desc: Creates an isolated RNG context using exact unsigned 64-bit decimal string seeds.
      parameters:
        - name: init_state
          type: string
          desc: Starting state for the RNG as an unsigned 64-bit decimal string.
        - name: init_seq
          type: string
          desc: Output sequence for the RNG as an unsigned 64-bit decimal string.
      returns:
        - name: Id
          type: number
          desc: RNG context id.

    - name: reset
      type: function
      desc: Reseeds an existing RNG context. Call with only id to seed from entropy, with id and init_state to use init_seq = 1, or with id, init_state, and init_seq for exact unsigned 32-bit deterministic seeding.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
        - name: init_state
          type: number
          desc: Optional starting state for the RNG. Must be an unsigned 32-bit integer.
        - name: init_seq
          type: number
          desc: Optional output sequence for the RNG. Must be an unsigned 32-bit integer.

    - name: reset64
      type: function
      desc: Reseeds an existing RNG context using exact unsigned 64-bit decimal string seeds.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
        - name: init_state
          type: string
          desc: Starting state for the RNG as an unsigned 64-bit decimal string.
        - name: init_seq
          type: string
          desc: Output sequence for the RNG as an unsigned 64-bit decimal string.

    - name: delete
      type: function
      desc: Deletes an RNG context. The context id becomes invalid.
      parameters:
        - name: id
          type: number
          desc: RNG context id.

    - name: clear_contexts
      type: function
      desc: Deletes all RNG contexts. Existing context ids become invalid.

    - name: state
      type: function
      desc: Returns raw PCG state and increment as unsigned 64-bit decimal strings.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
      returns:
        - name: State
          type: string
          desc: Raw PCG state.
        - name: Increment
          type: string
          desc: Raw PCG increment. Controls the PCG stream.

    - name: set_state
      type: function
      desc: Restores raw PCG state and increment from unsigned 64-bit decimal strings.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
        - name: state
          type: string
          desc: Raw PCG state.
        - name: increment
          type: string
          desc: Raw PCG increment. Controls the PCG stream.

    - name: number
      type: function
      desc: Returns a 32-bit unsigned integer.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
      returns:
        - name: Random Number
          type: number
          desc: Returns a 32-bit unsigned integer.

    - name: numbers
      type: function
      desc: Returns a table of 32-bit unsigned integers.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
        - name: count
          type: number
          desc: Number of values to generate. Must be a non-negative integer.
      returns:
        - name: Random Numbers
          type: table
          desc: Table of 32-bit unsigned integers.

    - name: bound
      type: function
      desc: Returns a 32-bit unsigned integer in [0, upper_bound).
      parameters:
        - name: id
          type: number
          desc: RNG context id.
        - name: upper_bound
          type: number
          desc: Exclusive upper bound. Must be an unsigned 32-bit integer greater than 0.
      returns:
        - name: Random Number
          type: number
          desc: Returns a 32-bit unsigned integer in [0, upper_bound).

    - name: range
      type: function
      desc: Returns a 32-bit unsigned integer between min and max values, inclusive. Only unsigned integers are supported.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
        - name: min
          type: number
          desc: Minimum unsigned integer.
        - name: max
          type: number
          desc: Maximum unsigned integer.
      returns:
        - name: Random Number
          type: number
          desc: Returns a 32-bit unsigned integer between min and max values.

    - name: ranges
      type: function
      desc: Returns a table of 32-bit unsigned integers between min and max values, inclusive.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
        - name: count
          type: number
          desc: Number of values to generate. Must be a non-negative integer.
        - name: min
          type: number
          desc: Minimum unsigned integer.
        - name: max
          type: number
          desc: Maximum unsigned integer.
      returns:
        - name: Random Numbers
          type: table
          desc: Table of 32-bit unsigned integers between min and max values.

    - name: double
      type: function
      desc: Returns a floating point number in [0, 1).
      parameters:
        - name: id
          type: number
          desc: RNG context id.
      returns:
        - name: Random Number
          type: number
          desc: Returns a floating point number in [0, 1).

    - name: doubles
      type: function
      desc: Returns a table of floating point numbers in [0, 1).
      parameters:
        - name: id
          type: number
          desc: RNG context id.
        - name: count
          type: number
          desc: Number of values to generate. Must be a non-negative integer.
      returns:
        - name: Random Numbers
          type: table
          desc: Table of floating point numbers in [0, 1).

    - name: double_range
      type: function
      desc: Returns a floating point number in [min, max). Not fast as rnd.double(id)
      parameters:
        - name: id
          type: number
          desc: RNG context id.
        - name: min
          type: number
          desc: Minimum number.
        - name: max
          type: number
          desc: Maximum number.
      returns:
        - name: Random Number
          type: number
          desc: Returns a floating point number in [min, max).

    - name: boolean
      type: function
      desc: Returns true or false with equal probability.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
      returns:
        - name: Random Boolean
          type: boolean
          desc: Random boolean value.

    - name: chance
      type: function
      desc: Returns true according to the given probability.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
        - name: probability
          type: number
          desc: Probability from 0.0 to 1.0. Values <= 0 are always false and values >= 1 are always true.
      returns:
        - name: Success
          type: boolean
          desc: True if the probability check succeeds.

    - name: toss
      type: function
      desc: Toss a coin.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
      returns:
        - name: Random Number
          type: number
          desc: Returns 0 or 1 (0 = 'H', 1 = 'T')

    - name: roll
      type: function
      desc: Roll the dice.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
      returns:
        - name: Random Number
          type: number
          desc: Returns between 1-6

    - name: card
      type: function
      desc: Picks a standard deck card index.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
      returns:
        - name: Card
          type: number
          desc: Card index in [1, 52].

    - name: card2
      type: function
      desc: Picks a standard deck suit and rank.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
      returns:
        - name: Suit
          type: number
          desc: Suit in [1, 4].
        - name: Card
          type: number
          desc: Card rank in [1, 13].

    - name: dice
      type: function
      desc: Rolls dice using one of the exported dice constants.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
        - name: roll
          type: number
          desc: Roll count. Must be greater than 0.
        - name: type
          type: number
          desc: Dice type. Use rnd.d4, rnd.d6, rnd.d8, rnd.d10, rnd.d12, rnd.d20, or rnd.d100.
      returns:
        - name: Results
          type: table
          desc: Table of dice results.
        - name: Total
          type: number
          desc: Total amount of dice results.

    - name: shuffle
      type: function
      desc: Shuffles the array part of a table in place using Fisher-Yates.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
        - name: array
          type: table
          desc: Table to shuffle.
      returns:
        - name: Array
          type: table
          desc: The same table, shuffled in place.

    - name: check
      type: function
      desc: Debug/sample method that prints PCG sample output and consumes RNG state.
      parameters:
        - name: id
          type: number
          desc: RNG context id.
